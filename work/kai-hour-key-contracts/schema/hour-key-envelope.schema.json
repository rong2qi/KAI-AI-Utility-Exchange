{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kai.com/schemas/hour-key-envelope.schema.json",
  "title": "KAI account-bound Hour Key envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["key_id", "account_id", "key_version", "grant_ids", "audience", "issued_at", "expires_at", "receipt_until", "manifest_uri", "signature", "revocation_id"],
  "properties": {
    "key_id": { "type": "string", "minLength": 8 },
    "account_id": { "type": "string", "minLength": 1 },
    "key_version": { "type": "integer", "minimum": 1 },
    "grant_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "audience": { "const": "kai-runtime" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "receipt_until": { "type": "string", "format": "date-time" },
    "manifest_uri": { "type": "string", "format": "uri" },
    "signature": { "type": "string", "minLength": 16 },
    "revocation_id": { "type": "string", "minLength": 1 }
  }
}
