{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kai.com/schema/provider-sandbox-config.schema.json",
  "title": "KAI Internal Provider Sandbox Configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "provider_id": { "type": "string", "minLength": 1 },
    "profile": {
      "type": "string",
      "enum": ["success", "transient_failure", "timeout", "permanent_failure", "malformed_result"]
    },
    "supported_models": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "supported_regions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "timeout_ms": { "type": "integer", "minimum": 1 },
    "seed": { "type": "string", "minLength": 1 }
  },
  "required": ["profile", "supported_models", "supported_regions"]
}
