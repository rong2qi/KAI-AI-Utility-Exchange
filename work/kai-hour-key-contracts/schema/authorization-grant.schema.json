{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kai.com/schemas/authorization-grant.schema.json",
  "title": "KAI authorization grant",
  "type": "object",
  "additionalProperties": false,
  "required": ["grant_id", "account_id", "version", "scope_epoch", "resource_scope", "capability_scope", "slot", "issued_at", "expires_at", "receipt_until", "allow_provider_switch"],
  "properties": {
    "grant_id": { "type": "string", "minLength": 1 },
    "account_id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "scope_epoch": { "type": "integer", "minimum": 1 },
    "resource_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["models", "providers", "regions"],
      "properties": {
        "models": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "providers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "regions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "capability_scope": { "type": "array", "items": { "enum": ["compute", "discovery.read", "discovery.lock", "usage.receipt"] }, "minItems": 1 },
    "slot": {
      "type": "object", "additionalProperties": false,
      "required": ["slot_start", "lock_deadline", "slot_end", "time_zone"],
      "properties": {
        "slot_start": { "type": "string", "format": "date-time" },
        "lock_deadline": { "type": "string", "format": "date-time" },
        "slot_end": { "type": "string", "format": "date-time" },
        "time_zone": { "type": "string", "minLength": 1 }
      }
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "receipt_until": { "type": "string", "format": "date-time" },
    "revoked_at": { "type": "string", "format": "date-time" },
    "allow_provider_switch": {
      "type": "boolean",
      "default": false,
      "description": "Whether this grant explicitly permits a provider switch; runtime still requires provider scope, time, Holding, and confirmation checks."
    }
  },
  "$defs": {
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_start", "lock_deadline", "slot_end", "time_zone"],
      "properties": {
        "slot_start": { "type": "string", "format": "date-time" },
        "lock_deadline": { "type": "string", "format": "date-time" },
        "slot_end": { "type": "string", "format": "date-time" },
        "time_zone": { "type": "string", "minLength": 1 }
      }
    }
  }
}
