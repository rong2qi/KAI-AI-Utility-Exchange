{
  "name": "kai-hour-key-contracts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <25.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=75 --test-coverage-functions=90 test/*.test.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "security:audit": "npm audit --audit-level=high",
    "quality:verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run provider:sandbox:verify && npm run http:sandbox:verify && npm run xfyun:contract:verify && npm run staging:rehearsal:verify && npm run staging:gate:verify && npm run staging:target:verify && npm run staging:runtime:verify && npm run staging:bundle:verify && npm run security:audit",
    "provider:sandbox:verify": "node scripts/provider-sandbox-verify.mjs",
    "http:sandbox:verify": "node scripts/local-http-sandbox-verify.mjs",
    "xfyun:contract:verify": "node scripts/xfyun-contract-verify.mjs",
    "xfyun:keychain:check": "node scripts/xfyun-keychain-check.mjs",
    "xfyun:live:smoke": "node scripts/xfyun-live-smoke.mjs",
    "staging:rehearsal:verify": "node scripts/staging-rehearsal-verify.mjs",
    "staging:gate:verify": "node scripts/staging-gate-verify.mjs",
    "staging:target:verify": "node scripts/staging-target-verify.mjs",
    "staging:runtime:verify": "node scripts/staging-runtime-verify.mjs",
    "staging:bundle:verify": "node scripts/staging-bundle.mjs --version local-verify --output /tmp/staging.tar.gz",
    "ci:verify": "node scripts/ci-verify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "7.0.2"
  }
}
